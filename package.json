{
  "name": "bwiza-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "AI co-pilot for clinic front desks — symptom triage, specialty routing, and clinician-ready notes (Rwanda healthcare).",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "vercel-build": "npm run build --prefix client",
    "start": "npm run start --prefix server"
  },
  "dependencies": {
    "@vercel/node": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
